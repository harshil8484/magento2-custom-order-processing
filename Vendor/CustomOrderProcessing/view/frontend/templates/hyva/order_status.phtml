<div x-data="orderStatus">
    <template x-if="orderId">
        <div class="mt-4 p-4 bg-gray-100 rounded-lg">
            <h3 class="text-lg font-bold mb-2">Update Order Status</h3>
            <select x-model="newStatus" class="p-2 border rounded">
                <option value="processing">Processing</option>
                <option value="shipped">Shipped</option>
                <option value="complete">Complete</option>
            </select>
            <button @click="updateStatus(orderId, newStatus)" 
                    class="ml-2 px-4 py-2 bg-blue-600 text-white rounded">
                Update
            </button>
            <p x-text="message" class="mt-2 text-green-600"></p>
        </div>
    </template>
</div>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('orderStatus', () => ({
        orderId: null,
        newStatus: 'processing',
        message: '',
        async updateStatus(orderId, newStatus) {
            try {
                const response = await fetch(
                    `${window.BASE_URL}rest/V1/custom-order/status-update`,
                    {
                        method: 'POST',
                        headers: { 
                            'Authorization': `Bearer ${window.API_TOKEN}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ 
                            orderIncrementId: orderId, 
                            newStatus: newStatus 
                        })
                    }
                );
                const result = await response.json();
                this.message = result ? 'Status updated!' : 'Failed to update status';
            } catch (error) {
                this.message = 'Error: ' + error.message;
            }
        }
    }));
});
</script>